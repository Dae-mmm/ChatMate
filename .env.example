# Impostale nelle Environment Variables del progetto Vercel (non nel repo)
SUPABASE_URL=https://<progetto>.supabase.co
SUPABASE_ANON_KEY=<chiave anon / publishable>
CHESS_SERVER_SECRET=<stringa casuale lunga, la stessa di cui salvi l'hash nel DB>
KEY_ENC_SECRET=<32 byte casuali in base64, es. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">
